<?xml version="1.0"?>
<robot name="simple_boat">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.35" ixy="0.0" ixz="0.0" iyy="0.9" iyz="0.0" izz="1.1"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 0.42 0.20"/>
      </geometry>
      <material name="HullBlue">
        <color rgba="0.10 0.35 0.75 1.0"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0.42 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.18 0.14"/>
      </geometry>
      <material name="BowWhite">
        <color rgba="0.95 0.95 0.95 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 0.42 0.20"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <gravity>false</gravity>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <link name="sonar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.04"/>
      </geometry>
      <material name="SonarBlack">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_sonar" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_link"/>
    <origin xyz="0 0 -0.04" rpy="0 1.57079632679 0"/>
  </joint>

  <gazebo reference="sonar_link">
    <gravity>false</gravity>
    <sensor type="ray" name="downward_multibeam_sonar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>128</samples>
            <resolution>1</resolution>
            <min_angle>-0.78539816339</min_angle>
            <max_angle>0.78539816339</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.20</min>
          <max>60.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </ray>
      <plugin name="downward_multibeam_sonar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/sonar/downward/points</remapping>
        </ros>
        <frame_name>sonar_link</frame_name>
        <output_type>sensor_msgs/PointCloud2</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="simple_boat_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <publish_rate>20</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.001</covariance_yaw>
    </plugin>
  </gazebo>
</robot>